# Copy these into the Node.js app's environment variables in DirectAdmin (never commit real values)
DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/DBNAME
APP_URL=https://complyscope.pentarchsystemssolutions.co.ke
SUPERADMIN_EMAILS=admin@example.com
# Optional
CRON_SECRET=
UPLOAD_DIR=/home/USER/complyscope_data/uploads
# Optional but recommended: a long random string used to encrypt integration secrets.
# If unset, the key is derived from DATABASE_URL, so changing the database password means re-entering
# the SMTP / M-Pesa / SMS secrets in Admin → Integrations & billing.
CONFIG_KEY=
# Integrations are normally set up in Admin → Integrations & billing.
# These variables are only a fallback.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ComplyScope Kenya <complyscope@pentarchsystemssolutions.co.ke>"
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TYPE=paybill
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
